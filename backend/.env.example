PORT=5000
NODE_ENV=development


SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key


# --- Ecobank Developer API (Azure APIM) ---
# Leave ECOBANK_ENABLED=false until the values below are filled from your
# logged-in sandbox at apimuat-developer.ecobank.com. When false (or when a
# value is missing), /api/ecobank/eligibility falls back to a score-only
# decision instead of calling the bank.
ECOBANK_ENABLED=false
ECOBANK_BASE_URL=https://apimuat-developer.ecobank.com
ECOBANK_TIMEOUT_MS=15000
# Access tokens are ~5 min and scoped per service; refreshed automatically.
ECOBANK_TOKEN_TTL_MS=300000

# Credentials used to mint a token from the Authentication service.
# Send only the ones the portal's "Try it" console actually requires.
ECOBANK_USERNAME=
ECOBANK_PASSWORD=
ECOBANK_CLIENT_ID=
ECOBANK_CLIENT_SECRET=

# One Azure APIM subscription key per subscribed product (Ocp-Apim-Subscription-Key).
ECOBANK_SUBKEY_AUTH=
ECOBANK_SUBKEY_ACCOUNT_ENQUIRY=
ECOBANK_SUBKEY_BILL_PAYMENT=

# Endpoint paths for each service (copy exactly from the portal API description).
ECOBANK_PATH_AUTH=
ECOBANK_PATH_ACCOUNT_ENQUIRY=
ECOBANK_PATH_BILL_PAYMENT=

# serviceCode sent in each request body (from the portal's API Service Code page).
ECOBANK_SERVICECODE_AUTH=
ECOBANK_SERVICECODE_ACCOUNT_ENQUIRY=
ECOBANK_SERVICECODE_BILL_PAYMENT=
